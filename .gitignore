# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# uv / virtualenv
.venv/

# Run artifacts (traces + persisted notebooks a live run writes; not source). The settings
# page writes notebooks/.settings — inside an already-ignored directory, and deliberately NOT a
# .json file, since list_notebook_summaries globs notebooks/*.json (which pathlib matches against
# dotfiles too) and would report it as a corrupt notebook.
/traces/
/notebooks/
*.jsonl

# Secrets / local env (only .env.example is tracked)
.env

# Local research/design notes that fed into AGENTS.md/CHANGELOG.md's durable invariants and
# decisions — not tracked, per the same reasoning as not publishing raw design-debate transcripts:
# the resolved "what and why" belongs in AGENTS.md/CHANGELOG.md, not the working notes that
# produced it.
#
# `docs/invariants/` is the ONE exception and IS tracked: it holds the argument behind each
# indexed invariant, which is durable by definition. Note the shape — `/docs/*` excludes the
# CONTENTS, where `/docs/` would exclude the directory itself and stop git ever descending into
# it, which makes the negation below silently dead. Verified in a scratch repo, not assumed.
/docs/*
!/docs/invariants/

# macOS
.DS_Store

# Claude Code local overrides (never commit)
.claude/settings.local.json
.claude/scheduled_tasks.lock

# Built by playground/build.py — regenerate rather than edit.
/playground/dist/
