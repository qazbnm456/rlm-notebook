# Copy to .env and fill in before running `rlm-notebook ask`. NOTHING here is auto-loaded — source
# it yourself (`set -a; . ./.env; set +a`) or export the vars.
#
# Most of these are read by `rlm_notebook/config.py` via `NotebookConfig.from_env`. Six are NOT,
# deliberately: `RN_MAX_UPLOAD_BYTES`, `RN_FETCH_ALLOW_CIDRS`, `RN_TRACE_RETENTION_DAYS`,
# `RN_MAX_TRACE_FILES` and `RN_OUTPUT_LANGUAGE` have standalone readers, and `RN_TTS_PROVIDER` is
# read a second time in `api.py`. `from_env` raises when `RN_MAIN_MODEL` is unset, and uploading a
# file, tidying traces or serving the settings page must all work on a server with no model
# configured (AGENTS.md invariants 24, 30 and 41). rlm-harness's own
# `RLMConfig.from_env()` reads a separate `RLM_*` surface; rlm-notebook passes the `RN_*` values
# below into rlm-harness explicitly rather than sharing that surface (see config.py's docstring).

# --- Model (required for a live run) ------------------------------------------------------------

# The RLM's main model, driving the REPL loop. REQUIRED — `ask` refuses to start without it.
# Write the provider-prefixed id litellm expects, e.g. openai/gpt-4o, anthropic/claude-sonnet-5.
RN_MAIN_MODEL=

# Sub LM (rlm-harness's `llm_query` escalation). Defaults to RN_MAIN_MODEL; set it only to split roles.
# RN_SUB_MODEL=

# API key and endpoint for whichever provider RN_MAIN_MODEL points at.
RN_API_KEY=
# RN_BASE_URL=https://your-endpoint/v1     # OpenAI-compatible proxy (then use the plain ids it serves)

# --- Budgets (sane defaults; override only if you know why) -------------------------------------

# How many REPL steps the main model gets. 25, not rlm-harness's own 10: the failure modes are not
# symmetric — exhausting it loses a run already paid for, while unused headroom costs nothing (the
# loop ends when the model submits) and a runaway is bounded by RN_RUN_TIMEOUT_SECONDS instead. Every
# task here explores a whole notebook's corpus blob by .find()/slicing, which costs a step per probe.
# RN_MAX_ITERATIONS=25
# RN_MAX_LLM_CALLS=30
# How many times a whole RLM run may be re-attempted. PINNED at 1, like every sibling: a re-run
# rarely fixes a PERSISTENT coercion failure, and it burns the budget again while writing a second
# copy of the same failure into the trace. Raise it only deliberately.
# RN_MAX_RETRIES=1

# The per-call generation cap, applied to BOTH the main and sub LM (rlm-harness builds one
# lm_kwargs and hands it to each). 32768, not RLMConfig's own 8192: dspy reads `content` and
# DISCARDS `reasoning_content`, so a reasoning model's chain-of-thought is billed against a cap it
# never appears in — the reply comes back empty or cut mid-JSON, and `max_retries=1` makes that
# terminal. `ctx-distillery` documents the same trap and recommends this value.
# RN_MAX_TOKENS=32768
# How much of a REPL output reaches the planner's prompt (dspy head+tail-truncates past it). The
# last field of the same shape as RN_MAX_TOKENS; `ctx-distillery`'s audit found exactly those two and
# raised its own to 40000. Every task here explores the corpus by .find()/slicing and prints spans,
# so a truncated output costs an iteration to re-fetch.
# RN_MAX_OUTPUT_CHARS=40000
# RN_ADAPTER=json

# --- rlm-notebook-specific ------------------------------------------------------------------------

# Size cap (characters) on the assembled corpus blob — AGENTS.md invariant 8. Default 8,000,000.
# RN_MAX_CORPUS_CHARS=8000000

# Which OCR backend scanned/image PDF pages are dispatched to: "local" (default, RapidOCR/Tesseract
# — core dependencies, always installed) or "vision_llm" (deferred — not yet implemented, see
# AGENTS.md invariant 7).
# RN_OCR_PROVIDER=local

# The sandbox `AnswerQuestion` runs in. PINNED to "pyodide": setting anything else does not quietly
# get corrected, it REFUSES to start (AGENTS.md invariant 9) — an operator who set this believes
# something about the run that would not be true. Listed so the refusal is not a surprise.
# RN_INTERPRETER=pyodide

# Which TTS backend `rlm-notebook audio` dispatches to. Two are implemented, and `tts._PROVIDERS`
# is the one list of known names (`get_tts_provider` refuses loudly on anything else).
# "edge-tts" (default) needs no key and no download, but reaches an undocumented Microsoft
# endpoint. "chatterbox" is fully LOCAL — no network at all — behind `uv sync --extra chatterbox`,
# which pulls torch/transformers (~109 packages, ~1GB) and downloads weights on first use. It
# writes WAV rather than MP3; the file endpoint follows the file's own format (invariant 43).
#
# Local is SLOWER, by a lot: measured end to end on Apple Silicon, a 3.4-minute episode took 16
# minutes (15 of them synthesis, RTF ~4.5). Only the script half of /audio is cancellable.
# RN_TTS_PROVIDER=edge-tts

# The Audio Overview's two-host voice cast (edge-tts voice ids; AGENTS.md invariant 18 on why the
# cast is fixed at two hosts). Run `edge-tts --list-voices` to see other options.
# Also settable from the web UI's settings page; this variable still WINS, and the page shows
# a row it pins as disabled. See AGENTS.md invariant 41.
# For "chatterbox" these are voice NAMES, not edge-tts ids: "host-a"/"host-b" are the two
# reference clips shipped in rlm_notebook/voices/ (see the README there for where they came from),
# and "built-in" is Chatterbox's own single voice. An ABSOLUTE PATH to your own reference .wav also
# works HERE, in the environment — deliberately not from the settings page, which would make it an
# arbitrary-file-read surface on an unauthenticated endpoint.
# RN_TTS_VOICE_HOST_A=en-US-GuyNeural
# RN_TTS_VOICE_HOST_B=en-US-JennyNeural

# --- rlm-notebook API only (uv sync --extra api; see api.py) -------------------------------------

# How long (seconds) api.py's runner.wait_result waits for a subprocess-isolated run before
# cancelling it (killpg) and reporting a timeout. Distinct from RN_MAX_ITERATIONS/RN_MAX_LLM_CALLS
# (which bound the RLM loop's STEPS, not wall-clock time). cli.py's in-process commands ignore
# this entirely — only the API's subprocess-isolated path uses it.
#
# The DEFAULT depends on how the main model is served, because the two are an order of magnitude
# apart: 300s for a direct API model, but 1800s whenever RN_MAIN_MODEL uses the `claude-agent-sdk/`
# prefix, which spawns a Claude Code CLI subprocess per LM call. A user on that path hit
# `502 … timed out after 300.0s` with a trace holding one run_start and nothing else — cancelled
# before its first step ever returned. Setting this explicitly overrides both — but NOT verbatim
# for a podcast: `/audio` multiplies it by `schema.PODCAST_TIMEOUT_FACTOR` (short 1.0, default 2.0,
# long 5.0), so 300 here means 1500s for a `long` episode. A tier that asks for 60-90 accumulated
# utterances cannot finish inside a chat turn's budget; see AGENTS.md invariant 68.
# RN_RUN_TIMEOUT_SECONDS=300

# Run a role on your Claude Pro/Max SUBSCRIPTION instead of an API key: prefix the model with
# `claude-agent-sdk/`. rlm-harness's ClaudeAgentLM is injected by config.setup (AGENTS.md invariant
# 35); rlm-harness 1.10.0 also routes on the prefix itself, so the injection wins rather than
# enables. Needs the `subscription` extra
# (`uv sync --extra subscription`) AND the Claude Code CLI installed and logged in; no RN_API_KEY /
# RN_BASE_URL is used for a role on this path. Mixed auth is fine: put one role on the subscription
# and leave the other on the proxy. NOTE: ClaudeAgentLM REFUSES to start if ANTHROPIC_API_KEY is
# set in your environment — the Claude Code CLI silently prefers it over subscription OAuth, which
# would quietly bill API credit instead.
# RN_MAIN_MODEL=claude-agent-sdk/claude-sonnet-5
# RN_SUB_MODEL=claude-agent-sdk/claude-fable-5

# Cap (bytes) on one file POSTed to /notebooks/{id}/sources/upload. Read independently of every
# other RN_* var above — deliberately NOT gated behind RN_MAIN_MODEL being set (AGENTS.md
# invariant 30): uploading a source has nothing to do with whether a model is configured.
# RN_MAX_UPLOAD_BYTES=50000000

# CIDRs the SSRF guard should treat as EXTERNAL. Empty by default, which is full strictness — set
# this ONLY if your own resolver lies to you. A fake-IP proxy or split-DNS VPN (Clash / Mihomo /
# Surge, default range 198.18.0.0/16) answers every public hostname with a synthetic address in a
# RESERVED range, so the guard refuses it — correctly, on what it can see — and EVERY web and
# YouTube ingestion fails with "resolves to a disallowed address". The guard cannot tell an
# operator's own resolver from an attacker's redirect, which is why this has to be opt-in and
# operator-supplied. An entry is refused unless it is a CIDR, and refused AGAIN if it overlaps
# loopback, cloud metadata, RFC1918 or multicast — listing one of those does not widen the
# carve-out, it switches the DNS-rebinding check off for that range, and `is_safe_url` is NOT a
# backstop: it refuses a URL whose host is a LITERAL blocked IP and passes anything that merely
# RESOLVES to one. So `0.0.0.0/0` is rejected outright rather than trusted to be harmless. A typo
# is refused rather than skipped, because skipping it restores the exact failure the variable was
# set to fix. Read independently of RN_MAIN_MODEL, same as RN_MAX_UPLOAD_BYTES above.
# A split-DNS VPN mapping internal names into RFC1918 cannot be carved out here, deliberately:
# that is the SSRF this guard exists to prevent.
# RN_FETCH_ALLOW_CIDRS=198.18.0.0/16

# Force the language model-authored prose is written in — answers, guide artifacts, the notebook
# title. A HARD override: it applies to chat as well as artifacts, and skips the automatic
# resolution entirely (NotebookLM's equivalent forced-language setting works the same way). Leave it
# unset and the language is resolved ONCE per notebook by a cheap model call weighing the browser's
# Accept-Language, the sources' own language, and any questions already asked — a judgement, not a
# lookup, because Accept-Language answers "what language should this browser's UI be in", not "what
# language does this person want their research written in" (AGENTS.md invariant 39).
#
# Citation coordinates are NEVER translated whatever this says: a source_id, a locator and a quote
# stay exactly as they appear in the sources, in the source's own language.
#
# The Audio Overview follows it too: the resolved language picks the default voice pair
# (tts.default_voices_for), so a Chinese notebook gets a Chinese script AND a Chinese cast. Setting
# RN_TTS_VOICE_HOST_A/_B below overrides that — an explicit choice always wins, and the two resolve
# independently, so setting one leaves the other following the language.
# Also settable from the web UI's settings page; this variable still WINS, and the page shows
# a row it pins as disabled. See AGENTS.md invariant 41.
# RN_OUTPUT_LANGUAGE=Traditional Chinese

# Retention for the reasoning-trace files the API writes to traces/{run_id}.jsonl. A trace can hold
# FULL ingested source text the model echoed while reading it, and this API has no authentication
# (AGENTS.md invariant 25), so "keep everything forever" is a poor default. Set either to 0 to
# disable that sweep. An in-flight run's trace, and anything written in the last hour, is never
# pruned regardless — so the file cap is a SOFT cap under a burst of runs. Read independently of
# RN_MAIN_MODEL, same as RN_MAX_UPLOAD_BYTES above; a malformed value refuses server startup.
# RN_TRACE_RETENTION_DAYS=7
# RN_MAX_TRACE_FILES=500
